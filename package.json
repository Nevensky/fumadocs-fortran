{
  "name": "fumadocs-fortran",
  "version": "0.0.0",
  "description": "Fortran API reference for fumadocs: its own parser, FORD, Doxygen and LAPACK doc comments, and HPC awareness (OpenMP, OpenACC, MPI, BLAS, LAPACK, ScaLAPACK)",
  "keywords": [
    "fumadocs",
    "fortran",
    "documentation",
    "api-reference",
    "ford",
    "doxygen",
    "lapack",
    "openmp",
    "mpi",
    "hpc",
    "mdx"
  ],
  "license": "MIT",
  "author": {
    "name": "Neven Golenić",
    "url": "https://github.com/Nevensky"
  },
  "funding": "https://thanks.dev/u/gh/nevensky",
  "homepage": "https://nevensky.github.io/fumadocs-fortran/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nevensky/fumadocs-fortran.git"
  },
  "bugs": {
    "url": "https://github.com/Nevensky/fumadocs-fortran/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "fumadocs-fortran": "bin/fumadocs-fortran.js"
  },
  "files": [
    "bin",
    "src",
    "fumadocs",
    "react",
    "registry",
    "shiki",
    "types",
    "style.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "default": "./react/index.js"
    },
    "./mermaid": {
      "types": "./types/mermaid.d.ts",
      "default": "./react/mermaid.js"
    },
    "./mdx": {
      "types": "./types/mdx.d.ts",
      "default": "./fumadocs/mdx.js"
    },
    "./source": {
      "types": "./types/source.d.ts",
      "default": "./fumadocs/source.js"
    },
    "./math": {
      "types": "./types/math.d.ts",
      "default": "./src/docs/math.js"
    },
    "./shiki": {
      "types": "./types/shiki.d.ts",
      "default": "./shiki/index.js"
    },
    "./shiki/*.json": "./shiki/*.json",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "node test/run.mjs",
    "test:registry": "node test/registry/check.mjs",
    "test:shiki": "node test/shiki/run.mjs",
    "gate": "node scripts/gate.mjs",
    "registry": "node scripts/registry/build.mjs",
    "build:grammars": "node scripts/build-grammars.mjs",
    "prepublishOnly": "node test/run.mjs && node test/registry/check.mjs"
  },
  "peerDependencies": {
    "fumadocs-core": ">=16",
    "pele": ">=1.13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    },
    "pele": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
